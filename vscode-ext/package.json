{
  "name": "djobs",
  "displayName": "djobs — Local Agent Memory",
  "description": "Shared local project memory and explicit coordination for AI coding agents across sessions and tools.",
  "version": "0.22.0",
  "publisher": "jhuang-tw",
  "license": "MIT",
  "icon": "media/icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhuang-tw/djobs"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "djobs",
    "coding agent",
    "shared agent memory",
    "local agent memory",
    "repository memory",
    "agent coordination",
    "cross-agent handoff",
    "context recovery",
    "MCP",
    "Model Context Protocol",
    "GitHub Copilot",
    "Claude Code",
    "Codex",
    "Gemini",
    "Kimi Code",
    "passive hooks"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "djobs launches a local Python MCP process and may update user-level agent hook configuration. Trust the workspace before enabling it."
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "djobsServerProvider",
        "label": "djobs"
      }
    ],
    "commands": [
      {
        "command": "djobs.setup",
        "title": "Set up / Repair djobs",
        "category": "djobs"
      },
      {
        "command": "djobs.diagnose",
        "title": "Diagnose Setup",
        "category": "djobs"
      },
      {
        "command": "djobs.memory",
        "title": "Show Repository Memory",
        "category": "djobs"
      },
      {
        "command": "djobs.gain",
        "title": "Show Memory Gain",
        "category": "djobs"
      },
      {
        "command": "djobs.receipt",
        "title": "Show Work Receipt",
        "category": "djobs"
      },
      {
        "command": "djobs.pause",
        "title": "Pause djobs",
        "category": "djobs"
      },
      {
        "command": "djobs.unpause",
        "title": "Resume djobs",
        "category": "djobs"
      },
      {
        "command": "djobs.memoryRefresh",
        "title": "Refresh Memory Explorer",
        "category": "djobs",
        "icon": "$(refresh)"
      },
      {
        "command": "djobs.memoryExposure",
        "title": "Choose Memory Exposure",
        "category": "djobs",
        "icon": "$(filter)"
      },
      {
        "command": "djobs.memorySearch",
        "title": "Search Memory Abstracts",
        "category": "djobs",
        "icon": "$(search)"
      },
      {
        "command": "djobs.memoryOpen",
        "title": "Inspect Memory",
        "category": "djobs"
      },
      {
        "command": "djobs.memoryDepth",
        "title": "Choose Content Depth",
        "category": "djobs"
      },
      {
        "command": "djobs.memoryReview",
        "title": "Review Memory with Human Confirmation",
        "category": "djobs"
      },
      {
        "command": "djobs.memoryForget",
        "title": "Forget Memory with Confirmation",
        "category": "djobs"
      },
      {
        "command": "djobs.memoryTrace",
        "title": "Explain Memory Retrieval",
        "category": "djobs"
      }
    ],
    "configuration": {
      "title": "djobs",
      "properties": {
        "djobs.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to a Python executable with djobs installed. Leave empty to auto-detect .venv, djobs, or Python on PATH."
        },
        "djobs.dbPath": {
          "type": "string",
          "default": "djobs_mcp.db",
          "description": "Workspace-local djobs database path. Used only when djobs.queueLocation is workspace."
        },
        "djobs.queueLocation": {
          "type": "string",
          "enum": [
            "workspace",
            "global"
          ],
          "default": "global",
          "enumDescriptions": [
            "Keep a separate local-memory database in this workspace.",
            "Share ~/.djobs/global.db while keeping recovery scoped to each repository."
          ],
          "description": "Where local repository memory and explicit checkpoint state are stored."
        },
        "djobs.globalDbPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path for shared local memory. Leave empty for ~/.djobs/global.db."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "djobsMemoryExplorer",
          "name": "djobs Memory",
          "when": "isWorkspaceTrusted"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "djobsMemoryExplorer",
        "contents": "Open a trusted workspace to inspect local memory. Reads do not claim tasks or accept candidates."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "djobs.memoryRefresh",
          "when": "view == djobsMemoryExplorer",
          "group": "navigation"
        },
        {
          "command": "djobs.memorySearch",
          "when": "view == djobsMemoryExplorer",
          "group": "navigation"
        },
        {
          "command": "djobs.memoryExposure",
          "when": "view == djobsMemoryExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "djobs.memoryDepth",
          "when": "view == djobsMemoryExplorer && viewItem == djobsMemoryItem",
          "group": "inspect"
        },
        {
          "command": "djobs.memoryReview",
          "when": "view == djobsMemoryExplorer && viewItem == djobsMemoryItem",
          "group": "review"
        },
        {
          "command": "djobs.memoryForget",
          "when": "view == djobsMemoryExplorer && viewItem == djobsMemoryItem",
          "group": "maintenance"
        },
        {
          "command": "djobs.memoryTrace",
          "when": "view == djobsMemoryExplorer",
          "group": "inspect"
        }
      ]
    }
  },
  "scripts": {
    "sync-version": "node scripts/sync-version.js",
    "vscode:prepublish": "npm run sync-version && npm run compile",
    "compile": "npm run sync-version && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.101.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.0.0"
  },
  "homepage": "https://jhuang-tw.github.io/djobs/",
  "bugs": {
    "url": "https://github.com/jhuang-tw/djobs/issues"
  },
  "galleryBanner": {
    "color": "#272A3A",
    "theme": "dark"
  },
  "preview": true,
  "pricing": "Free"
}
