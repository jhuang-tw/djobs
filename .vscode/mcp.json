{
  "servers": {
    "djobs": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "djobs.public_cli",
        "mcp"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "DJOBS_AGENT_TYPE": "copilot"
      },
      "autoApprove": [
        "sync_workspace",
        "resume_delta"
      ]
    }
  }
}
