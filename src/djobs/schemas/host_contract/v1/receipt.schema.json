{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhuang-tw.github.io/djobs/schemas/host-contract/v1/receipt.schema.json",
  "title": "djobs observation query receipt v1",
  "type": "object",
  "required": [
    "receipt_kind",
    "request_id",
    "query_fingerprint",
    "requested_at",
    "completed_at",
    "candidate_count",
    "selected_count",
    "rejected_count",
    "rejection_reasons",
    "output_hash",
    "hash_scope",
    "provider_version",
    "provider_build_commit",
    "repository_fingerprint",
    "repository_head",
    "token_budget",
    "truncated"
  ],
  "properties": {
    "receipt_kind": {"const": "observation_query"},
    "request_id": {"type": "string", "minLength": 1},
    "query_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requested_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "candidate_count": {"type": "integer", "minimum": 0},
    "selected_count": {"type": "integer", "minimum": 0},
    "rejected_count": {"type": "integer", "minimum": 0},
    "rejection_reasons": {"type": "object"},
    "output_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hash_scope": {"const": "response_without_receipt"},
    "provider_version": {"type": "string"},
    "provider_build_commit": {"type": "string"},
    "repository_fingerprint": {"type": "string"},
    "repository_head": {"type": "string"},
    "token_budget": {"type": "object"},
    "truncated": {"type": "boolean"}
  },
  "additionalProperties": true
}
