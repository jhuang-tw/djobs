{
  "name": "djobs",
  "displayName": "djobs — Crash-Proof Task Memory",
  "description": "Sidebar view for djobs: see task status, one-click resume, audit trail.",
  "version": "0.8.4",
  "publisher": "jhuang-tw",
  "license": "MIT",
  "icon": "media/icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhuang-tw/djobs"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "djobs",
    "durable",
    "crash-recovery",
    "ai-agent",
    "mcp",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/djobs_mcp.db",
    "workspaceContains:.vscode/mcp.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "djobsServerProvider",
        "label": "djobs"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "djobs",
          "title": "djobs",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "djobs": [
        {
          "id": "djobsTasks",
          "name": "Tasks"
        }
      ]
    },
    "commands": [
      {
        "command": "djobs.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "djobs"
      },
      {
        "command": "djobs.startWorkflow",
        "title": "Start Tracked Workflow",
        "icon": "$(add)",
        "category": "djobs"
      },
      {
        "command": "djobs.resumeAll",
        "title": "Resume Incomplete Tasks",
        "icon": "$(play)",
        "category": "djobs"
      },
      {
        "command": "djobs.copyTaskId",
        "title": "Copy Task ID",
        "category": "djobs"
      },
      {
        "command": "djobs.inspectTask",
        "title": "Inspect Task",
        "category": "djobs"
      },
      {
        "command": "djobs.toggleScope",
        "title": "Toggle Scope: All / Current Workspace",
        "icon": "$(globe)",
        "category": "djobs"
      },
      {
        "command": "djobs.toggleQueueLocation",
        "title": "Toggle Queue: Workspace / Global",
        "icon": "$(database)",
        "category": "djobs"
      },
      {
        "command": "djobs.resumeFromHere",
        "title": "Resume from here",
        "icon": "$(play)",
        "category": "djobs"
      },
      {
        "command": "djobs.skipTask",
        "title": "Skip this task",
        "icon": "$(debug-step-over)",
        "category": "djobs"
      },
      {
        "command": "djobs.archiveWorkflow",
        "title": "Archive this workflow",
        "icon": "$(archive)",
        "category": "djobs"
      },
      {
        "command": "djobs.resumeWorkflow",
        "title": "Resume this workflow",
        "icon": "$(play)",
        "category": "djobs"
      },
      {
        "command": "djobs.diagnose",
        "title": "Diagnose Setup",
        "icon": "$(pulse)",
        "category": "djobs"
      },
      {
        "command": "djobs.setup",
        "title": "Set up / Repair djobs",
        "icon": "$(tools)",
        "category": "djobs"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "djobs.startWorkflow",
          "when": "view == djobsTasks",
          "group": "navigation"
        },
        {
          "command": "djobs.refresh",
          "when": "view == djobsTasks",
          "group": "navigation"
        },
        {
          "command": "djobs.resumeAll",
          "when": "view == djobsTasks",
          "group": "navigation"
        },
        {
          "command": "djobs.toggleScope",
          "when": "view == djobsTasks",
          "group": "navigation"
        },
        {
          "command": "djobs.archiveWorkflow",
          "when": "view == djobsTasks",
          "group": "navigation"
        },
        {
          "command": "djobs.diagnose",
          "when": "view == djobsTasks",
          "group": "9_diagnostics"
        },
        {
          "command": "djobs.setup",
          "when": "view == djobsTasks",
          "group": "9_diagnostics"
        }
      ],
      "view/item/context": [
        {
          "command": "djobs.resumeWorkflow",
          "when": "view == djobsTasks && viewItem == workflowGroup",
          "group": "inline"
        },
        {
          "command": "djobs.archiveWorkflow",
          "when": "view == djobsTasks && viewItem == workflowGroup",
          "group": "inline"
        },
        {
          "command": "djobs.resumeWorkflow",
          "when": "view == djobsTasks && viewItem == actionGroup",
          "group": "inline"
        },
        {
          "command": "djobs.archiveWorkflow",
          "when": "view == djobsTasks && viewItem == actionGroup",
          "group": "inline"
        },
        {
          "command": "djobs.resumeFromHere",
          "when": "view == djobsTasks && viewItem == task",
          "group": "inline"
        },
        {
          "command": "djobs.skipTask",
          "when": "view == djobsTasks && viewItem == task",
          "group": "inline"
        },
        {
          "command": "djobs.copyTaskId",
          "when": "view == djobsTasks && viewItem == task"
        },
        {
          "command": "djobs.inspectTask",
          "when": "view == djobsTasks && viewItem == task"
        }
      ]
    },
    "configuration": {
      "title": "djobs",
      "properties": {
        "djobs.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to Python executable with djobs installed. Leave empty to auto-detect from .venv or PATH."
        },
        "djobs.dbPath": {
          "type": "string",
          "default": "djobs_mcp.db",
          "description": "Path to the djobs SQLite database (relative to workspace root). Ignored when djobs.queueLocation is set to global."
        },
        "djobs.queueLocation": {
          "type": "string",
          "enum": [
            "workspace",
            "global"
          ],
          "default": "global",
          "enumDescriptions": [
            "Each workspace uses its own djobs_mcp.db.",
            "All workspaces share one global queue (djobs.globalDbPath) (default)."
          ],
          "description": "Where the task queue lives. 'global' (default) shares one queue across all projects and Python environments; 'workspace' keeps a separate queue per project."
        },
        "djobs.globalDbPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the shared global queue database. Leave empty to use ~/.djobs/global.db. Only used when djobs.queueLocation is 'global'."
        },
        "djobs.scope": {
          "type": "string",
          "enum": [
            "allWorkspaces",
            "currentWorkspace"
          ],
          "default": "currentWorkspace",
          "description": "Task scope shown in the sidebar. Defaults to currentWorkspace so unrelated projects do not mix together. Use allWorkspaces for every task in the configured database."
        },
        "djobs.showCompleted": {
          "type": "boolean",
          "default": false,
          "description": "Show completed tasks in the sidebar. Disabled by default to keep the task list focused on active work."
        },
        "djobs.autoTakeoverPrompt": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Legacy on/off switch for automatic takeover. Prefer `djobs.autoTakeoverMode` for new setups."
        },
        "djobs.autoTakeoverMode": {
          "type": "string",
          "enum": [
            "askOnce",
            "openChat",
            "prompt",
            "off"
          ],
          "default": "askOnce",
          "enumDescriptions": [
            "Ask once per workspace whether djobs may automatically take over future AI work. Allowing it does not open Chat immediately.",
            "Zero-click mode: when djobs is ready, automatically open Chat with the resume/start workflow prompt for future sessions.",
            "Ask before opening Chat once per extension version.",
            "Do not proactively start or resume djobs workflows."
          ],
          "description": "How djobs should proactively bring AI work into durable workflow state when a workspace opens."
        },
        "djobs.autoRefreshInterval": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "Auto-refresh interval in seconds."
        }
      }
    }
  },
  "scripts": {
    "sync-version": "node scripts/sync-version.js",
    "vscode:prepublish": "npm run sync-version && npm run compile",
    "compile": "npm run sync-version && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.101.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.0.0"
  }
}
